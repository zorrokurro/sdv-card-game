{
  "name": "SDV",
  "deckBuilding": {
    "mainFilters": ["type", "cost"],
    "formats": [
      { "title": "Standard", "gameplay": "Standard" }
    ],
    "deckRulesets": {
      "Standard": {
        "general": { "min": 60, "max": 60, "maxPerCard": 1 }
      }
    }
  },
  "gameplay": {
    "Standard": {
      "mulligan": { "startingHandSize": 5 },
      "newTurn": { "drawOnStart": true, "drawPerTurn": 1 },
      "countersStartingValues": [20],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            { "section": "Board" },
            {
              "direction": "row",
              "content": [
                { "section": "Energy" },
                { "section": "Dissipation" },
                { "section": "Extinction" }
              ]
            }
          ]
        },
        "sectionsDict": {
          "Board": {
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          },
          "Energy": {
            "isHidden": "opponent-only",
            "height": "SMALL",
            "alignment": "CENTER",
            "displayedTitle": "Energy Zone",
            "isHorizontalAllowed": true
          },
          "Dissipation": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "CENTER",
            "displayedTitle": "Dissipation"
          },
          "Extinction": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "CENTER",
            "displayedTitle": "Extinction",
            "noQuickActions": true
          }
        }
      }
    }
  },
  "cards": {
    "dataUrl": "./cards.json",
    "cardBack": "./cardback.svg"
  },
  "defaultRessources": {
    "decksUrl": "./decks.json"
  }
}
