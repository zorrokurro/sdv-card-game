{
  "name": "SDV-TCG",
  "deckBuilding": {
    "mainFilters": ["type", "cost"],
    "formats": [
      { "title": "Standard", "gameplay": "Standard", "deckRuleset": "Standard" }
    ],
    "deckRulesets": {
      "Standard": {
        "general": { "min": 40, "max": 60, "maxPerCard": 4 }
      }
    }
  },
  "gameplay": {
    "Standard": {
      "mulligan": { "startingHandSize": 5 },
      "newTurn": { "drawOnStart": true, "drawPerTurn": 1 },
      "countersStartingValues": [20],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            { "section": "Board" },
            {
              "direction": "row",
              "content": [
                { "section": "Energy", "style": { "width": "34%" } },
                { "section": "Dissipation", "style": { "width": "33%" } },
                { "section": "Extinction", "style": { "width": "33%" } }
              ]
            }
          ]
        },
        "sectionsDict": {
          "Board": { "isHidden": "no", "height": "MEDIUM", "alignment": "CENTER" },
          "Energy": {
            "isHidden": "opponent-only",
            "height": "SMALL",
            "alignment": "CENTER",
            "displayedTitle": "Energy Zone"
          },
          "Dissipation": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER", "displayedTitle": "Dissipation" },
          "Extinction": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER", "displayedTitle": "Extinction" }
        },
        "autoPlayFromHand": {
          "生物": "Board",
          "法術": "Board",
          "場地": "Board"
        },
        "autoPlayFromStack": {
          "法術": "Dissipation"
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://cdn.jsdelivr.net/gh/zorrokurro/sdv-card-game@master/cards.json?v=6",
    "cardBack": "https://cdn.jsdelivr.net/gh/zorrokurro/sdv-card-game@master/cards-final-v3/card_back.png",
    "version": 5
  },
  "defaultRessources": {
    "decksUrl": "https://cdn.jsdelivr.net/gh/zorrokurro/sdv-card-game@master/decks.json"
  }
}
